rules_version = '2';
// Playlist: who can read and write what.
// - Every visitor has an anonymous Firebase login (request.auth.uid).
// - Entering a code creates members/{uid} = {code}. That membership is what lets someone read the chat,
//   post as themselves, and read only their own private messages.
// - Admin: logging in writes adminSessions/{uid} with the password; it must equal config/admin.key,
//   which nobody can read (change it in the Firebase console). A session lasts 12 hours.
// - Door staff: the same, with doorSessions/{uid} and config/door (the admin sets that password in the panel).
//   Door staff can only look up tickets and check people in.
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function codePath(c) { return /databases/$(database)/documents/codes/$(c); }
    function memberPath() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function sessionPath() { return /databases/$(database)/documents/adminSessions/$(request.auth.uid); }
    function signedIn() { return request.auth != null; }
    // "Log everyone out" (admin): logins from before site/session.epoch no longer count
    function epochPath() { return /databases/$(database)/documents/site/session; }
    function fresh(ts) { return !exists(epochPath()) || ts > get(epochPath()).data.epoch; }
    function isMember() { return signedIn() && exists(memberPath()) && fresh(get(memberPath()).data.ts); }
    function myCode() { return get(memberPath()).data.code; }
    function isAdmin() {
      return signedIn() && exists(sessionPath())
        && get(sessionPath()).data.ts > request.time - duration.value(12, 'h');
    }
    function doorPath() { return /databases/$(database)/documents/doorSessions/$(request.auth.uid); }
    function isDoor() {
      return signedIn() && exists(doorPath())
        && get(doorPath()).data.ts > request.time - duration.value(12, 'h')
        && fresh(get(doorPath()).data.ts);
    }
    function canDoor() { return isAdmin() || isDoor(); }
    function ticketPath(t) { return /databases/$(database)/documents/tickets/$(t); }
    function isToken(v) { return v is string && v.matches('^[A-Z2-9]{12}$'); }
    // the ticket token saved on the member's own code
    function ownsTicket(t) { return isMember() && get(codePath(myCode())).data.get('ticket', null) == t; }
    function orderPath(id) { return /databases/$(database)/documents/orders/$(id); }
    function stylePath(c) { return /databases/$(database)/documents/styles/$(c); }
    // a member's own bubble design: saved together with marking their paid bubble order as used
    function boughtBubble(code) {
      return isMember() && myCode() == code
        && getAfter(stylePath(code)).data.get('order', null) is string
        && get(orderPath(getAfter(stylePath(code)).data.order)).data.code == code
        && get(orderPath(getAfter(stylePath(code)).data.order)).data.item == 'bubble'
        && get(orderPath(getAfter(stylePath(code)).data.order)).data.status == 'paid'
        && getAfter(orderPath(getAfter(stylePath(code)).data.order)).data.status == 'used';
    }
    function isHex(v) { return v is string && v.matches('^#[0-9A-Fa-f]{6}$'); }
    // profile colour: 0 = whitish … 100 = vibrant
    function okShade(d) { return !('shade' in d) || (d.shade is number && d.shade >= 0 && d.shade <= 100); }
    // once an account has a colour it stays; only a reset (username back to null) clears it
    function shadeLocked() {
      return !('shade' in resource.data)
        || request.resource.data.username == null
        || request.resource.data.get('shade', null) == resource.data.shade;
    }
    // code kinds: none = green, 'blue' (experimental), 'rare' (designed by the admin), 'admin' (the admin's chat account)
    function okKind(d, code) {
      return !('kind' in d) || d.kind in ['blue', 'rare'] || (d.kind == 'admin' && code == '_admin');
    }

    // the admin password (create once; after that only the Firebase console can change it)
    // and the door password (set and changed by the admin). Nobody can read either.
    function okKey(d) { return d.keys().hasOnly(['key']) && d.key is string && d.key.size() >= 4 && d.key.size() <= 64; }
    match /config/{doc} {
      allow read: if false;
      allow create: if (doc == 'admin' && okKey(request.resource.data))
        || (doc == 'door' && isAdmin() && okKey(request.resource.data));
      allow update: if doc == 'door' && isAdmin() && okKey(request.resource.data);
      allow delete: if false;
    }

    match /doorSessions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['key','ts','name'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 20))
        && request.resource.data.ts == request.time
        && request.resource.data.key == get(/databases/$(database)/documents/config/door).data.key;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /adminSessions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['key','ts'])
        && request.resource.data.ts == request.time
        && request.resource.data.key == get(/databases/$(database)/documents/config/admin).data.key;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // entering a code: only codes that exist, and never the admin's chat account
    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code','ts'])
        && request.resource.data.code is string && request.resource.data.code != '_admin'
        && exists(codePath(request.resource.data.code))
        && request.resource.data.ts == request.time;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /codes/{code} {
      // people only see their own code; the admin sees all
      allow get: if isAdmin() || (isMember() && myCode() == code);
      allow list: if isAdmin();
      allow create: if isAdmin() && code.lower() != 'admin'
        && request.resource.data.keys().hasOnly(['username','kind'])
        && request.resource.data.username == null
        && okKind(request.resource.data, code);
      // a person may claim their own free code (username + colour) or pick a colour once;
      // the admin may rename, reset, and turn a free code rare / normal
      allow update: if (isAdmin()
          || (isMember() && myCode() == code
            && (resource.data.username == null || request.resource.data.username == resource.data.username)
            && request.resource.data.get('tint', null) == resource.data.get('tint', null)))
        && request.resource.data.keys().hasOnly(['username','claimedAt','shade','kind','tint','ticket'])
        // the entry ticket: a member sets it once; the admin may issue or clear it
        && (request.resource.data.get('ticket', null) == resource.data.get('ticket', null)
          || (isAdmin() && (request.resource.data.get('ticket', null) == null || isToken(request.resource.data.ticket)))
          || (isMember() && myCode() == code && resource.data.get('ticket', null) == null
            && isToken(request.resource.data.get('ticket', null))
            && existsAfter(ticketPath(request.resource.data.ticket))))
        && okKind(request.resource.data, code)
        && (request.resource.data.get('kind', 'green') == resource.data.get('kind', 'green')
          || (isAdmin() && resource.data.username == null && request.resource.data.username == null)
          || (request.resource.data.get('kind', 'green') == 'rare' && boughtBubble(code)))
        && (!('tint' in request.resource.data) || isHex(request.resource.data.tint))
        && okShade(request.resource.data)
        && shadeLocked()
        && (request.resource.data.username == null
          || (request.resource.data.username is string
            && request.resource.data.username.matches('^[^/]{2,20}$')
            && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower()))));
      allow delete: if isAdmin();
    }

    match /usernames/{name} {
      allow get: if isMember() || isAdmin();
      allow list: if false;
      // written together with the code it belongs to (claim, or an admin rename)
      allow create, update: if (isAdmin() || (isMember() && myCode() == request.resource.data.code))
        && request.resource.data.keys().hasOnly(['code'])
        && getAfter(codePath(request.resource.data.code)).data.username.lower() == name;
      allow delete: if isAdmin();
    }

    match /messages/{id} {
      allow read: if isMember() || isAdmin();
      // you can only post as the code you are logged in with (the admin posts as _admin)
      allow create: if ((isMember() && myCode() == request.resource.data.code)
          || (isAdmin() && request.resource.data.code == '_admin'))
        && request.resource.data.keys().hasOnly(['code','username','text','ts','shade','kind','tint'])
        && request.resource.data.get('kind', 'green') == get(codePath(request.resource.data.code)).data.get('kind', 'green')
        && (!('tint' in request.resource.data) || isHex(request.resource.data.tint))
        && okShade(request.resource.data)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.ts == request.time
        && get(codePath(request.resource.data.code)).data.username == request.resource.data.username;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // the look of a rare code
    match /styles/{code} {
      allow read: if isMember() || isAdmin();
      allow write: if (isAdmin() || boughtBubble(code))
        && request.resource.data.keys().hasOnly(['texture','strength','tint','ink','weight','radius','zoom','px','py','gloss','glow','shimmer','order'])
        && inRange(request.resource.data, 'zoom', 1, 4)
        && inRange(request.resource.data, 'px', 0, 100) && inRange(request.resource.data, 'py', 0, 100)
        && inRange(request.resource.data, 'gloss', 0, 1) && inRange(request.resource.data, 'glow', 0, 1)
        && (!('shimmer' in request.resource.data) || request.resource.data.shimmer is bool)
        && (request.resource.data.texture == null
          || (request.resource.data.texture is string && request.resource.data.texture.size() < 400000))
        && request.resource.data.strength is number && request.resource.data.strength >= 0 && request.resource.data.strength <= 1
        && isHex(request.resource.data.tint) && isHex(request.resource.data.ink)
        && request.resource.data.weight is number && request.resource.data.weight >= 100 && request.resource.data.weight <= 900
        && request.resource.data.radius is number && request.resource.data.radius >= 0 && request.resource.data.radius <= 40;
      allow delete: if isAdmin();
    }

    // private messages: only the sender, the recipient and the admin can read them
    match /dms/{id} {
      allow read: if isAdmin()
        || (isMember() && (resource.data.to == myCode() || resource.data.from == myCode()));
      allow create: if ((isMember() && myCode() == request.resource.data.from)
          || (isAdmin() && request.resource.data.from == '_admin'))
        && request.resource.data.keys().hasOnly(['from','fromName','to','toName','text','ts'])
        && request.resource.data.from != request.resource.data.to
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.to + '_' + request.resource.data.from))
        && get(codePath(request.resource.data.from)).data.username == request.resource.data.fromName
        && exists(codePath(request.resource.data.to))
        && request.resource.data.toName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.ts == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // one like per pair of accounts; the doc id is "<from>_<to>"; you can only like as yourself
    match /likes/{id} {
      allow read: if isMember() || isAdmin();
      allow create: if ((isMember() && myCode() == request.resource.data.from)
          || (isAdmin() && request.resource.data.from == '_admin'))
        && request.resource.data.keys().hasOnly(['from','to','ts'])
        && id == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.from != request.resource.data.to
        && get(codePath(request.resource.data.from)).data.username != null
        && exists(codePath(request.resource.data.to))
        && request.resource.data.ts == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (isMember() && resource.data.from == myCode());
    }

    // entry tickets: the id is a random token (never the login code), shown as a QR on the member's phone.
    // The doc holds only the name and colour, so door staff never see login codes.
    match /tickets/{t} {
      allow get: if canDoor() || ownsTicket(t);
      allow list: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['name','shade','kind','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && okShade(request.resource.data)
        && (!('kind' in request.resource.data) || request.resource.data.kind in ['blue', 'rare'])
        && request.resource.data.ts == request.time
        && (isAdmin()
          || (isMember() && getAfter(codePath(myCode())).data.get('ticket', null) == t
            && request.resource.data.name == get(codePath(myCode())).data.username));
      allow delete: if isAdmin();
    }

    // check-ins at the door: one per ticket, never changed; only the admin can undo one
    match /checkins/{t} {
      allow get: if canDoor() || ownsTicket(t);
      allow list: if canDoor();
      allow create: if canDoor() && exists(ticketPath(t))
        && request.resource.data.keys().hasOnly(['ts','by','name','who'])
        && (!('who' in request.resource.data) || (request.resource.data.who is string && request.resource.data.who.size() <= 20))
        && request.resource.data.ts == request.time
        && request.resource.data.by in ['door', 'admin']
        && request.resource.data.name == get(ticketPath(t)).data.name;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // photos from the Camera app: a small preview (photos) and the full picture (photoData), saved together.
    // Only the person who took it and the admin can see them.
    match /photos/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.code == myCode());
      allow create: if isMember() && request.resource.data.code == myCode()
        && request.resource.data.keys().hasOnly(['code','username','thumb','w','h','ts','filter'])
        && (!('filter' in request.resource.data) || (request.resource.data.filter is string && request.resource.data.filter.size() <= 40))
        && request.resource.data.username == get(codePath(myCode())).data.username
        && request.resource.data.thumb is string && request.resource.data.thumb.size() < 60000
        && request.resource.data.w is number && request.resource.data.h is number
        && request.resource.data.ts == request.time
        && existsAfter(/databases/$(database)/documents/photoData/$(id));
      allow update: if false;
      allow delete: if isAdmin() || (isMember() && resource.data.code == myCode());
    }
    match /photoData/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.code == myCode());
      allow create: if isMember() && request.resource.data.code == myCode()
        && request.resource.data.keys().hasOnly(['code','image'])
        && request.resource.data.image is string && request.resource.data.image.size() < 1000000
        && existsAfter(/databases/$(database)/documents/photos/$(id));
      allow update: if false;
      allow delete: if isAdmin() || (isMember() && resource.data.code == myCode());
    }

    // camera filters made by the admin: a colour look-up table (.cube, stored as a small PNG) and/or an overlay image
    match /filters/{id} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','lut','overlay','opacity','blend','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
        && (request.resource.data.lut == null || (request.resource.data.lut is string && request.resource.data.lut.size() < 400000))
        && (request.resource.data.overlay == null || (request.resource.data.overlay is string && request.resource.data.overlay.size() < 650000))
        && inRange(request.resource.data, 'opacity', 0, 1)
        && request.resource.data.blend in ['normal', 'screen', 'multiply', 'overlay', 'soft']
        && request.resource.data.ts == request.time;
    }

    // the store. Real money: a member orders (pending), pays with MobilePay, and the admin marks it paid.
    // Likes: paid at once from the member's likes (the wallet's "spent" goes up by the price in the same write).
    // Prices come from site/prices (the admin sets them); these defaults apply until then.
    function pricesPath() { return /databases/$(database)/documents/site/prices; }
    function priceOf(item, def) { return exists(pricesPath()) ? get(pricesPath()).data.get(item, def) : def; }
    function walletPath(c) { return /databases/$(database)/documents/wallets/$(c); }
    function flipPath(id) { return /databases/$(database)/documents/flips/$(id); }
    function okPrice(d) {
      return (d.item == 'tshirt' && d.price == priceOf('tshirt', 200)) || (d.item == 'screen' && d.price == priceOf('screen', 50));
    }
    function okLikePrice(d) {
      return (d.item == 'bubble' && d.price == priceOf('bubble', 5)) || (d.item == 'avatar' && d.price == priceOf('avatar', 3))
        || (d.item == 'background' && d.price == priceOf('background', 5));
    }
    function okMsg(m) {
      return m.keys().hasOnly(['text','weight','tint','size'])
        && m.text is string && m.text.size() > 0 && m.text.size() <= 60
        && m.weight in [100, 300, 400, 700, 900] && isHex(m.tint) && m.size in ['S', 'M', 'L'];
    }
    match /orders/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.code == myCode());
      allow create: if isMember() && request.resource.data.code == myCode()
        && request.resource.data.name == get(codePath(myCode())).data.username
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 12
        && request.resource.data.ts == request.time
        && ((request.resource.data.keys().hasOnly(['code','name','item','price','ref','status','ts','size','msg'])
            && okPrice(request.resource.data)
            && request.resource.data.status == 'pending'
            && (request.resource.data.item != 'tshirt' || request.resource.data.get('size', '') in ['XS', 'S', 'M', 'L', 'XL', 'XXL'])
            && (request.resource.data.item != 'screen' || okMsg(request.resource.data.get('msg', {}))))
          || (request.resource.data.keys().hasOnly(['code','name','item','price','ref','status','ts','currency'])
            && request.resource.data.currency == 'likes' && request.resource.data.status == 'paid'
            && okLikePrice(request.resource.data)
            && getAfter(walletPath(myCode())).data.get('last', null) == id)
          || (request.resource.data.keys().hasOnly(['code','name','item','price','ref','status','ts','currency','size','msg','token'])
            && request.resource.data.currency == 'credit' && request.resource.data.status == 'paid'
            && okPrice(request.resource.data)
            && getAfter(walletPath(myCode())).data.get('last', null) == id
            && (request.resource.data.item != 'tshirt' || (request.resource.data.get('size', '') in ['XS', 'S', 'M', 'L', 'XL', 'XXL'] && isToken(request.resource.data.get('token', null))))
            && (request.resource.data.item != 'screen' || okMsg(request.resource.data.get('msg', {})))));
      allow update: if isAdmin()
        || (isMember() && resource.data.code == myCode()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && ((resource.data.status == 'pending' && request.resource.data.status == 'cancelled')
            || (resource.data.item == 'bubble' && resource.data.status == 'paid' && request.resource.data.status == 'used'
              && getAfter(stylePath(myCode())).data.get('order', null) == id)));
      allow delete: if isAdmin();
    }

    // likes to spend = likes received + bonus (the admin gives or takes) - spent (the store)
    // store credit (kr) = credit (the admin gives) - creditSpent (the store)
    match /wallets/{code} {
      function was(k) { return resource == null ? 0 : resource.data.get(k, 0); }
      function now(k) { return request.resource.data.get(k, 0); }
      function same(k) { return request.resource.data.get(k, null) == (resource == null ? null : resource.data.get(k, null)); }
      function lastOrder() { return getAfter(orderPath(request.resource.data.last)).data; }
      function okKeys() { return request.resource.data.keys().hasOnly(['bonus','spent','last','credit','creditSpent','dailyAt','storeDailyAt','flip','fb50','fb100']); }
      function sameFb() { return same('fb50') && same('fb100'); }
      function flappyBest() { return exists(/databases/$(database)/documents/flappy/$(code)) ? get(/databases/$(database)/documents/flappy/$(code)).data.best : 0; }
      function firstTime(k) { return request.resource.data.get(k, false) == true && (resource == null || resource.data.get(k, false) == false); }
      function flipBefore() { return get(flipPath(request.resource.data.flip)).data; }
      function flipAfter() { return getAfter(flipPath(request.resource.data.flip)).data; }
      allow read: if isAdmin() || (isMember() && myCode() == code);
      allow delete: if isAdmin(); // the admin's nuke
      allow create, update: if isAdmin() && okKeys()
        && now('bonus') is int && now('spent') is int && now('credit') is int && now('creditSpent') is int;
      // a member pays for the order they create in the same write: with likes, or with store credit (never more credit than they have)
      allow create, update: if isMember() && myCode() == code && okKeys()
        && request.resource.data.last is string && !exists(orderPath(request.resource.data.last))
        && lastOrder().code == code
        && now('bonus') == was('bonus') && now('credit') == was('credit') && same('dailyAt') && same('storeDailyAt') && same('flip') && sameFb()
        && ((lastOrder().currency == 'likes' && now('spent') == was('spent') + lastOrder().price && now('creditSpent') == was('creditSpent'))
          || (lastOrder().currency == 'credit' && now('creditSpent') == was('creditSpent') + lastOrder().price
            && now('spent') == was('spent') && now('creditSpent') <= now('credit')));
      // number 1 on the Flappy Bird leaderboard: 10 likes, once a day
      allow create, update: if isMember() && myCode() == code && okKeys()
        && now('bonus') == was('bonus') + 10 && now('spent') == was('spent')
        && now('credit') == was('credit') && now('creditSpent') == was('creditSpent') && same('last') && same('storeDailyAt') && same('flip') && sameFb()
        && request.resource.data.dailyAt == request.time
        && (resource == null || resource.data.get('dailyAt', null) == null || resource.data.dailyAt < request.time - duration.value(20, 'h'))
        && get(/databases/$(database)/documents/site/flappyTop).data.get('code', '') == code;
      // the Store's daily bonus (the admin sets how many likes in site/prices.daily; 0 = off)
      allow create, update: if isMember() && myCode() == code && okKeys()
        && priceOf('daily', 2) is int && priceOf('daily', 2) > 0
        && now('bonus') == was('bonus') + priceOf('daily', 2) && now('spent') == was('spent')
        && now('credit') == was('credit') && now('creditSpent') == was('creditSpent') && same('last') && same('dailyAt') && same('flip') && sameFb()
        && request.resource.data.storeDailyAt == request.time
        && (resource == null || resource.data.get('storeDailyAt', null) == null || resource.data.storeDailyAt < request.time - duration.value(20, 'h'));
      // Coin Flip: the stake goes in together with the flip (post one, take one, or play the bot);
      // winnings and taken-back flips come back as bonus. The flip's own rules check who may do what.
      allow create, update: if isMember() && myCode() == code && okKeys()
        && now('credit') == was('credit') && now('creditSpent') == was('creditSpent') && same('last') && same('dailyAt') && same('storeDailyAt') && sameFb()
        && request.resource.data.flip is string
        && ((!exists(flipPath(request.resource.data.flip)) && flipAfter().code == code
              && now('spent') == was('spent') + flipAfter().stake && now('bonus') == was('bonus'))
          || (exists(flipPath(request.resource.data.flip))
            && ((flipBefore().status == 'open' && flipAfter().status == 'done' && flipAfter().opp == code
                  && now('spent') == was('spent') + flipBefore().stake && now('bonus') == was('bonus'))
              || (flipBefore().status == 'done' && flipBefore().paid == false && flipAfter().paid == true
                  && now('bonus') == was('bonus') + 2 * flipBefore().stake && now('spent') == was('spent'))
              || (flipBefore().status == 'open' && flipBefore().code == code && flipAfter().status == 'cancelled'
                  && now('bonus') == was('bonus') + flipBefore().stake && now('spent') == was('spent')))));
      // Flappy Bird milestones, once each: 2 likes for reaching 50, 10 likes for reaching 100 (the saved best score must be there)
      allow create, update: if isMember() && myCode() == code && okKeys()
        && now('spent') == was('spent') && now('credit') == was('credit') && now('creditSpent') == was('creditSpent')
        && same('last') && same('dailyAt') && same('storeDailyAt') && same('flip')
        && ((firstTime('fb50') && same('fb100') && now('bonus') == was('bonus') + 2 && flappyBest() >= 50)
          || (firstTime('fb100') && same('fb50') && now('bonus') == was('bonus') + 10 && flappyBest() >= 100));
    }

    // (see the wallet: Flappy Bird milestones below the flips)
    // Coin Flip: a member puts likes on heads or tails. Someone takes the flip (or the bot does at once). The coin is the
    // server's clock at that moment (an even millisecond is heads), so nobody picks the result. The winner collects both stakes.
    function flipWinner(d) { return ((d.doneAt.toMillis() % 2 == 0) == (d.side == 'heads')) ? d.code : d.opp; }
    match /flips/{id} {
      allow read: if isMember() || isAdmin();
      allow create: if isMember() && appOn('coinflip')
        && request.resource.data.keys().hasOnly(['code','name','stake','side','vsBot','status','paid','ts','opp','oppName','doneAt'])
        && request.resource.data.code == myCode() && request.resource.data.name == get(codePath(myCode())).data.username
        && request.resource.data.stake is int && request.resource.data.stake >= 1 && request.resource.data.stake <= priceOf('flipMax', 20)
        && request.resource.data.side in ['heads', 'tails'] && request.resource.data.paid == false
        && request.resource.data.ts == request.time
        && getAfter(walletPath(myCode())).data.get('flip', '') == id
        && ((request.resource.data.vsBot == false && request.resource.data.status == 'open'
              && !('opp' in request.resource.data) && !('doneAt' in request.resource.data))
          || (request.resource.data.vsBot == true && request.resource.data.status == 'done'
              && request.resource.data.opp == '_bot' && request.resource.data.oppName == 'Bot' && request.resource.data.doneAt == request.time));
      // take someone else's open flip
      allow update: if isMember() && appOn('coinflip') && resource.data.status == 'open' && resource.data.code != myCode()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','opp','oppName','doneAt'])
        && request.resource.data.status == 'done' && request.resource.data.opp == myCode()
        && request.resource.data.oppName == get(codePath(myCode())).data.username
        && request.resource.data.doneAt == request.time
        && getAfter(walletPath(myCode())).data.get('flip', '') == id;
      // the winner collects (once)
      allow update: if isMember() && resource.data.status == 'done' && resource.data.paid == false && flipWinner(resource.data) == myCode()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid']) && request.resource.data.paid == true
        && getAfter(walletPath(myCode())).data.get('flip', '') == id;
      // take back your own open flip
      allow update: if isMember() && resource.data.status == 'open' && resource.data.code == myCode()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','doneAt'])
        && request.resource.data.status == 'cancelled' && request.resource.data.doneAt == request.time
        && getAfter(walletPath(myCode())).data.get('flip', '') == id;
      allow update, delete: if isAdmin();
    }
    // profile pictures (everyone logged in sees them) and personal backgrounds (only the owner), bought with likes
    function boughtWith(code, item, d) {
      return isMember() && myCode() == code && d.order is string
        && !exists(orderPath(d.order))
        && getAfter(orderPath(d.order)).data.code == code && getAfter(orderPath(d.order)).data.item == item;
    }
    match /avatars/{code} {
      allow read: if isMember() || isAdmin();
      allow create, update: if boughtWith(code, 'avatar', request.resource.data)
        && request.resource.data.keys().hasOnly(['image','order','ts'])
        && request.resource.data.image is string && request.resource.data.image.size() < 80000
        && request.resource.data.ts == request.time;
      allow delete: if isAdmin() || (isMember() && myCode() == code);
    }
    match /backgrounds/{code} {
      allow read: if isAdmin() || (isMember() && myCode() == code);
      allow create, update: if boughtWith(code, 'background', request.resource.data)
        && request.resource.data.keys().hasOnly(['image','order','ts'])
        && request.resource.data.image is string && request.resource.data.image.size() < 900000
        && request.resource.data.ts == request.time;
      allow delete: if isAdmin() || (isMember() && myCode() == code);
    }

    // T-shirt tickets (made by the admin when a T-shirt is paid), scanned once at the merch stand
    match /merch/{t} {
      allow get: if canDoor() || (isMember() && get(orderPath(resource.data.order)).data.code == myCode());
      allow list: if canDoor();
      allow create: if isAdmin()
        || (isMember() && request.resource.data.keys().hasOnly(['name','size','order','ts'])
          && !exists(orderPath(request.resource.data.order))
          && getAfter(orderPath(request.resource.data.order)).data.code == myCode()
          && getAfter(orderPath(request.resource.data.order)).data.currency == 'credit'
          && getAfter(orderPath(request.resource.data.order)).data.item == 'tshirt'
          && getAfter(orderPath(request.resource.data.order)).data.token == t
          && request.resource.data.ts == request.time);
      allow update: if canDoor() && !('usedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt','by','who'])
        && request.resource.data.usedAt == request.time
        && request.resource.data.by in ['door', 'admin'];
      allow delete: if isAdmin();
    }

    // paid screen messages, one after another, 6 hours each. Everyone sees them, so everyone can read the line.
    match /screenQueue/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if isMember() && !exists(orderPath(id))
        && getAfter(orderPath(id)).data.code == myCode()
        && getAfter(orderPath(id)).data.currency == 'credit' && getAfter(orderPath(id)).data.item == 'screen'
        && request.resource.data.keys().hasOnly(['name','text','weight','tint','size','startAt','endAt','ts'])
        && request.resource.data.startAt is timestamp && request.resource.data.startAt > request.time - duration.value(5, 'm')
        && request.resource.data.endAt == request.resource.data.startAt + duration.value(6, 'h')
        && request.resource.data.ts == request.time;
    }

    // apps the admin puts in the Store: his own pages (like ___), Song Wars and Flappy Bird. "gen" goes up whenever
    // an app is turned off, so people download it again when it comes back.
    function appOn(id) { return exists(/databases/$(database)/documents/apps/$(id)) && get(/databases/$(database)/documents/apps/$(id)).data.get('on', false) == true; }
    match /apps/{id} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['type','name','icon','on','gen','text','image','bg','fg','pickBy','order','ts'])
        && request.resource.data.type in ['page', 'songwars', 'flappy', 'coinflip']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
        && request.resource.data.on is bool && request.resource.data.gen is int
        && (request.resource.data.get('icon', null) == null || (request.resource.data.icon is string && request.resource.data.icon.size() < 80000))
        && (request.resource.data.get('image', null) == null || (request.resource.data.image is string && request.resource.data.image.size() < 400000))
        && request.resource.data.get('text', '').size() <= 500 && request.resource.data.get('pickBy', '').size() <= 80;
    }

    // Song Wars: one song per person (the doc id is their code), 1 to 3 minutes, with a title and a cover.
    // The song itself is stored in pieces (songChunks/<code>_<n>). Likes are a list of codes; the admin picks the winner.
    match /songs/{code} {
      allow read: if isMember() || isAdmin();
      allow create: if isMember() && myCode() == code && appOn('songwars')
        && request.resource.data.keys().hasOnly(['code','name','title','cover','dur','size','mime','chunks','likedBy','ts'])
        && request.resource.data.code == code && request.resource.data.name == get(codePath(code)).data.username
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 40
        && request.resource.data.cover is string && request.resource.data.cover.size() < 150000
        && request.resource.data.dur is number && request.resource.data.dur >= 60 && request.resource.data.dur <= 180
        && request.resource.data.chunks is int && request.resource.data.chunks > 0 && request.resource.data.chunks <= 26
        && request.resource.data.likedBy == [] && request.resource.data.ts == request.time;
      allow update: if (isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
          && request.resource.data.likedBy is list && request.resource.data.likedBy.size() <= 500
          && request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).hasOnly([myCode()])
          && resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).hasOnly([myCode()]))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['winner']) && request.resource.data.winner is bool);
      allow delete: if isAdmin() || (isMember() && myCode() == code);
    }
    match /songChunks/{id} {
      allow get: if isMember() || isAdmin();
      allow create: if isMember() && request.resource.data.code == myCode()
        && id.matches('^' + myCode() + '_[0-9]+$')
        && request.resource.data.keys().hasOnly(['code','i','data'])
        && request.resource.data.data is bytes && request.resource.data.data.size() <= 1000000;
      // your own pieces (named <your code>_<n>), even if one is already gone
      allow delete: if isAdmin() || (isMember() && id.matches('^' + myCode() + '_[0-9]+$'));
    }

    // Flappy Bird: each person's best score. The admin can take someone off the leaderboard.
    match /flappy/{code} {
      allow read: if isMember() || isAdmin();
      allow create, update: if isMember() && myCode() == code && appOn('flappy')
        && request.resource.data.keys().hasOnly(['name','best','ts'])
        && request.resource.data.name == get(codePath(code)).data.username
        && request.resource.data.best is int && request.resource.data.best >= 0 && request.resource.data.best <= 9999
        && (resource == null || request.resource.data.best > resource.data.best)
        && request.resource.data.ts == request.time;
      allow delete: if isAdmin();
    }

    // chat between door staff and the admin
    match /doorChat/{id} {
      allow read: if canDoor();
      allow create: if canDoor()
        && request.resource.data.keys().hasOnly(['name','text','role','ts'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.ts == request.time
        && ((isAdmin() && request.resource.data.role == 'admin' && request.resource.data.name == 'Admin')
          || (isDoor() && request.resource.data.role == 'door'
            && request.resource.data.name == get(doorPath()).data.get('name', 'Door')));
      allow delete: if isAdmin();
    }

    // Forum: posts (title, optional text and picture) that users see for 24 hours; likes are a list of codes on the post
    function mutedPath(c) { return /databases/$(database)/documents/muted/$(c); }
    function okPoster(d) {
      return isMember() && d.code == myCode() && !exists(mutedPath(myCode()))
        && d.name == get(codePath(myCode())).data.username
        && okShade(d) && (!('kind' in d) || d.kind in ['blue', 'rare']);
    }
    match /posts/{id} {
      allow read: if isMember() || isAdmin();
      allow create: if okPoster(request.resource.data)
        && request.resource.data.keys().hasOnly(['code','name','shade','kind','title','text','image','likedBy','ts'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 18
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 128))
        && (!('image' in request.resource.data) || (request.resource.data.image is string && request.resource.data.image.size() < 300000))
        && request.resource.data.likedBy == []
        && request.resource.data.ts == request.time;
      // liking: you can only add or remove yourself
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && request.resource.data.likedBy is list && request.resource.data.likedBy.size() <= 500
        && request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).hasOnly([myCode()])
        && resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).hasOnly([myCode()]);
      allow delete: if isAdmin() || (isMember() && resource.data.code == myCode());
    }
    match /comments/{id} {
      allow read: if isMember() || isAdmin();
      allow create: if okPoster(request.resource.data)
        && request.resource.data.keys().hasOnly(['post','code','name','shade','kind','text','ts'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.post))
        && request.resource.data.ts == request.time;
      allow delete: if isAdmin() || (isMember() && resource.data.code == myCode());
    }
    // the admin can mute someone in the forum
    match /muted/{code} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin();
    }
    // blocking: "<from>_<to>"; only you see who you blocked
    match /blocks/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.from == myCode());
      allow create: if isMember() && request.resource.data.from == myCode()
        && request.resource.data.keys().hasOnly(['from','to','toName','ts'])
        && id == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.from != request.resource.data.to
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 20
        && request.resource.data.ts == request.time;
      allow delete: if isAdmin() || (isMember() && resource.data.from == myCode());
    }

    // iTunes: videos and music the admin uploads. The file itself is split into pieces of up to 1 MB (mediaChunks/<id>_<n>).
    // status: 'free' (anyone logged in can download), 'soon' (listed, greyed out), 'removed' (gone from the store; people keep their copy)
    match /media/{id} {
      allow read: if isMember() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title','kind','status','mime','size','chunks','cover','dur','ts'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.kind in ['music', 'video']
        && request.resource.data.status in ['free', 'soon', 'removed']
        && request.resource.data.chunks is int && request.resource.data.chunks > 0 && request.resource.data.chunks <= 160
        && (request.resource.data.get('cover', null) == null
          || (request.resource.data.cover is string && request.resource.data.cover.size() < 150000));
      allow delete: if isAdmin();
    }
    match /mediaChunks/{id} {
      allow get: if isAdmin()
        || (isMember() && get(/databases/$(database)/documents/media/$(resource.data.media)).data.status == 'free');
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['media','i','data'])
        && request.resource.data.data is bytes && request.resource.data.data.size() <= 1000000;
      allow delete: if isAdmin();
    }

    // notifications: to one code (a like, a reply to your post, a private message, someone passing you in Flappy Bird)
    // or to 'all' (sent by the admin). The text is made by the app from these fields, so nobody can write whatever they like.
    match /notes/{id} {
      allow read: if isAdmin() || (isMember() && (resource.data.to == myCode() || resource.data.to == 'all'));
      allow create: if request.resource.data.keys().hasOnly(['to','kind','from','fromName','extra','ts'])
        && request.resource.data.ts == request.time
        && request.resource.data.get('extra', '') is string
        && ((isAdmin() && request.resource.data.kind == 'admin' && request.resource.data.to == 'all'
            && request.resource.data.extra.size() > 0 && request.resource.data.extra.size() <= 140)
          || (isMember() && request.resource.data.kind in ['like', 'reply', 'dm', 'flappy', 'flip']
            && request.resource.data.from == myCode()
            && request.resource.data.to is string && request.resource.data.to != myCode() && request.resource.data.to != 'all'
            && exists(codePath(request.resource.data.to))
            && request.resource.data.fromName == get(codePath(myCode())).data.username
            && request.resource.data.get('extra', '').size() <= 80));
      allow delete: if isAdmin() || (isMember() && resource.data.to == myCode());
    }

    // public site settings: up to three texts on everyone's screen, the countdown target,
    // the MobilePay number, and the "log everyone out" time
    function inRange(d, k, lo, hi) { return !(k in d) || (d[k] is number && d[k] >= lo && d[k] <= hi); }
    // the top of the chat: the admin's announcement and pinned messages (members only)
    match /chatTop/{doc} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin() && doc == 'board'
        && request.resource.data.keys().hasOnly(['announce','announceTs','pins','ts'])
        && request.resource.data.announce is string && request.resource.data.announce.size() <= 300
        && (request.resource.data.announceTs == null || request.resource.data.announceTs is number)
        && request.resource.data.pins is list && request.resource.data.pins.size() <= 5
        && request.resource.data.ts == request.time;
    }

    match /site/{doc} {
      allow read: if true;
      // a new Flappy Bird record: only with the score saved on your own leaderboard entry, and only if it beats the record
      allow write: if doc == 'flappyTop' && isMember()
        && request.resource.data.keys().hasOnly(['code','name','best','ts'])
        && request.resource.data.code == myCode()
        && request.resource.data.best == getAfter(/databases/$(database)/documents/flappy/$(myCode())).data.best
        && (resource == null || request.resource.data.best > resource.data.get('best', -1))
        && request.resource.data.ts == request.time;
      allow write: if isAdmin() && request.resource.data.ts == request.time
        && ((doc == 'screen'
            && request.resource.data.keys().hasOnly(['items','ts'])
            && request.resource.data.items is list && request.resource.data.items.size() <= 3)
          || (doc == 'countdown'
            && request.resource.data.keys().hasOnly(['target','ts'])
            && request.resource.data.target is timestamp)
          || (doc == 'prices'
            && request.resource.data.keys().hasOnly(['bubble','avatar','background','tshirt','screen','daily','flipMax','ts'])
            && inRange(request.resource.data, 'daily', 0, 100) && inRange(request.resource.data, 'flipMax', 1, 500))
          || (doc == 'wallpaper'
            && request.resource.data.keys().hasOnly(['image','phone','desktop','ts'])
            && (request.resource.data.get('image', null) == null
              || (request.resource.data.image is string && request.resource.data.image.size() < 950000)))
          || (doc == 'features'
            && request.resource.data.keys().hasOnly(['mystery','mysName','mysIcon','mysText','mysImage','mysBg','mysFg','ts'])
            && request.resource.data.get('mystery', false) is bool
            && request.resource.data.get('mysName', '') is string && request.resource.data.get('mysName', '').size() <= 20
            && request.resource.data.get('mysText', '') is string && request.resource.data.get('mysText', '').size() <= 500
            && (request.resource.data.get('mysIcon', null) == null || (request.resource.data.mysIcon is string && request.resource.data.mysIcon.size() < 80000))
            && (request.resource.data.get('mysImage', null) == null || (request.resource.data.mysImage is string && request.resource.data.mysImage.size() < 400000)))
          || (doc == 'session'
            && request.resource.data.keys().hasOnly(['epoch','ts'])
            && request.resource.data.epoch == request.time)
          || (doc == 'flappyTop'
            && request.resource.data.keys().hasOnly(['code','name','best','ts']))
          || (doc == 'limits'
            && request.resource.data.keys().hasOnly(['chatHours','postHours','spamOn','spamRow','spamGap','spamWait','ts'])
            && request.resource.data.get('spamOn', true) is bool
            && inRange(request.resource.data, 'chatHours', 0.25, 720) && inRange(request.resource.data, 'postHours', 1, 720)
            && inRange(request.resource.data, 'spamRow', 2, 50) && inRange(request.resource.data, 'spamGap', 1, 600)
            && inRange(request.resource.data, 'spamWait', 1, 3600))
          || (doc == 'store'
            && request.resource.data.keys().hasOnly(['mobilepay','ts'])
            && request.resource.data.mobilepay is string && request.resource.data.mobilepay.size() <= 20));
    }
  }
}
