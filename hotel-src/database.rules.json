      "$room": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && !data.exists() && $room === 'u_' + auth.uid && !newData.child('furni').exists() && !newData.child('skins').exists()",
        ".validate": "newData.hasChildren(['owner', 'ownerName', 'name', 'access', 'w', 'h'])",
