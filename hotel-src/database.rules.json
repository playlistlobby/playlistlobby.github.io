{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid && !data.exists() && newData.hasChildren(['name', 'gender', 'figure', 'blood']) && newData.child('blood').val() === 0",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16 && newData.val().matches(/^[A-Za-z0-9_.-]+$/)"
        },
        "gender": {
          ".validate": "newData.val() === 'M' || newData.val() === 'F'"
        },
        "figure": {
          ".validate": "newData.isString() && newData.val().length < 200"
        },
        "blood": {
          ".validate": "newData.isNumber() && newData.val() === 0"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "seenDoor": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        },
        "wardrobe": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
          "$slot": {
            ".validate": "$slot.matches(/^[0-7]$/) && newData.hasChildren(['figure', 'gender'])",
            "figure": {
              ".validate": "newData.isString() && newData.val().length < 200"
            },
            "gender": {
              ".validate": "newData.val() === 'M' || newData.val() === 'F'"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "logs": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid', 'name', 'type', 'detail', 'ts']) && newData.child('type').isString() && newData.child('type').val().matches(/^[a-z_]{2,20}$/) && newData.child('detail').isString() && newData.child('detail').val().length <= 160 && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('ts').val() === now"
      }
    },
    "config": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
      "shop": {
        "$section": {
          "$key": {
            ".validate": "newData.hasChildren(['on', 'price']) && newData.child('on').isBoolean() && newData.child('price').isNumber() && newData.child('price').val() >= 0 && newData.child('price').val() <= 999 && (!newData.child('starter').exists() || newData.child('starter').val() === true)"
          }
        }
      },
      "furniShop": {
        "today": {
          ".validate": "newData.hasChildren(['day', 'picks']) && newData.child('day').isNumber() && newData.child('picks').hasChildren()",
          "picks": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            }
          }
        },
        "prices": {
          "$kind": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
          }
        }
      },
      "npc": {
        "$id": {
          ".validate": "newData.hasChildren(['figure', 'gender']) && newData.child('figure').isString() && newData.child('figure').val().length < 200 && (newData.child('gender').val() === 'M' || newData.child('gender').val() === 'F')"
        }
      },
      "priceBook": {
        "clothing": {
          "$key": {
            ".validate": "newData.child('p').isNumber() && newData.child('p').val() >= 1 && newData.child('p').val() <= 999 && (newData.child('on').val() === 0 || newData.child('on').val() === 1)"
          }
        }
      }
    },
    "usernames": {
      "$name": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && !data.exists() && newData.val() === auth.uid",
        ".validate": "newData.isString()"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'figure'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
        },
        "figure": {
          ".validate": "newData.isString() && newData.val().length < 200 && (newData.val() === root.child('users').child($uid).child('figure').val() || auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid')"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "presence": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      "$uid": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "room": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "idle": {
          ".validate": "newData.isBoolean()"
        },
        "since": {
          ".validate": "newData.isNumber()"
        },
        "seen": {
          ".validate": "newData.isNumber()"
        },
        "sid": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
        "$friend": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ((auth.uid === $uid && (!newData.exists() || root.child('friendRequests').child($uid).child($friend).exists() || root.child('friends').child($friend).child($uid).exists())) || (auth.uid === $friend && (!newData.exists() || root.child('friendRequests').child(auth.uid).child($uid).exists())))",
          ".validate": "newData.hasChildren(['since']) && newData.child('since').isNumber()"
        }
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $to",
        "$from": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (($from === auth.uid && $from !== $to && !root.child('friends').child($to).child($from).exists()) || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['ts']) && newData.child('ts').isNumber()"
        }
      }
    },
    "dms": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
      "$uid": {
        "$other": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
          ".indexOn": [
            "ts"
          ],
          "$msg": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && !data.exists() && newData.child('from').val() === auth.uid && (auth.uid === $uid || auth.uid === $other) && root.child('friends').child($uid).child($other).exists() && root.child('friends').child($other).child($uid).exists()",
            ".validate": "newData.hasChildren(['from', 'text', 'ts']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 200 && newData.child('ts').isNumber()"
          }
        }
      }
    },
    "invites": {
      "$to": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $to",
        "$id": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ((auth.uid === $to && !newData.exists()) || (!data.exists() && newData.child('from').val() === auth.uid && root.child('friends').child($to).child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['room', 'roomName', 'from', 'fromName', 'ts'])"
        }
      }
    },
    "roomInvites": {
      "$room": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('roomsMeta').child($room).child('owner').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid && !newData.exists()",
          ".validate": "newData.val() === true"
        }
      }
    },
    "knocks": {
      "$owner": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $owner",
        "$visitor": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $visitor",
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ((auth.uid === $visitor && $visitor !== $owner && (!newData.exists() || root.child('roomsMeta').child('u_' + $owner).child('access').val() !== 'closed' && root.child('roomsMeta').child('u_' + $owner).child('access').val() !== 'none')) || (auth.uid === $owner && !newData.exists()))",
          ".validate": "newData.hasChildren(['name', 'ts']) && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('ts').isNumber() && newData.child('ts').val() === now"
        }
      }
    },
    "tradeInvites": {
      "$to": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $to",
        "$from": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ((auth.uid === $from && $from !== $to) || auth.uid === $to)",
          ".validate": "newData.hasChildren(['name', 'ts']) && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('ts').isNumber()"
        }
      }
    },
    "userTrades": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (auth.uid === $uid || newData.parent().parent().parent().child('trades').child($id).child('b').val() === auth.uid || newData.parent().parent().parent().child('trades').child($id).child('a').val() === auth.uid)",
          ".validate": "newData.val() === true"
        }
      }
    },
    "trades": {
      "$id": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid)",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && !data.exists() && newData.child('b').val() === auth.uid && newData.child('a').val() !== auth.uid",
        ".validate": "newData.hasChildren(['a', 'b', 'status'])",
