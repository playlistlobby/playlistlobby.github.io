          }
        },
        "status": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (data.parent().child('a').val() === auth.uid || data.parent().child('b').val() === auth.uid) && data.val() !== 'done' && newData.val() !== 'done'",
          ".validate": "newData.val() === 'open' || newData.val() === 'cancelled'"
        },
        "offer": {
          "$u": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $u && (data.parent().parent().child('a').val() === auth.uid || data.parent().parent().child('b').val() === auth.uid) && data.parent().parent().child('status').val() !== 'done' && !newData.parent().parent().child('ready').exists() && !newData.parent().parent().child('confirm').exists()",
            ".validate": "newData.hasChildren(['blood']) && newData.child('blood').isNumber() && newData.child('blood').val() >= 0 && newData.child('blood').val() <= 99999",
            "blood": {
              ".validate": "true"
            },
            "items": {
              "$slot": {
                ".validate": "$slot.matches(/^([0-9]|1[0-9]|2[0-7])$/) && newData.hasChildren(['item', 'qty']) && newData.child('item').isString() && newData.child('item').val().length <= 40 && newData.child('qty').isNumber() && newData.child('qty').val() >= 1 && newData.child('qty').val() <= 999",
                "item": {
                  ".validate": "true"
                },
                "qty": {
                  ".validate": "true"
                },
                "ass": {
                  ".validate": "newData.isBoolean()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "ready": {
          "$u": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (data.parent().parent().child('a').val() === auth.uid || data.parent().parent().child('b').val() === auth.uid) && data.parent().parent().child('status').val() !== 'done' && (auth.uid === $u || !newData.exists())",
            ".validate": "newData.val() === true"
          }
        },
        "confirm": {
          "$u": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (data.parent().parent().child('a').val() === auth.uid || data.parent().parent().child('b').val() === auth.uid) && data.parent().parent().child('status').val() !== 'done' && (auth.uid === $u || !newData.exists())",
            ".validate": "newData.val() === true"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "furni": {
      "meta": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        "$kind": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
          ".validate": "$kind.matches(/^x_[a-z0-9_]{1,24}$/) && newData.hasChildren(['name', 'w', 'h', 'players', 'flat'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 28"
          },
          "w": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8"
          },
          "h": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8"
          },
          "players": {
            ".validate": "newData.isBoolean()"
          },
          "flat": {
            ".validate": "newData.isBoolean()"
          },
          "ox": {
            ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200"
          },
          "oy": {
            ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200"
          },
          "height": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
          },
