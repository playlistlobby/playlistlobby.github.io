{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16 && newData.val().matches(/^[A-Za-z0-9_.-]+$/)" },
        "gender": { ".validate": "newData.val() === 'M' || newData.val() === 'F'" },
        "figure": { ".validate": "newData.isString() && newData.val().length < 200" },

        "blood": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() ? newData.val() <= 5 : (newData.val() <= data.val() || (newData.val() === data.val() + 1 && newData.parent().child('lastStabTarget').isString() && newData.parent().child('stabs').child(newData.parent().child('lastStabTarget').val()).val() === now - now % 86400000 && data.parent().child('stabs').child(newData.parent().child('lastStabTarget').val()).val() !== now - now % 86400000) || (newData.val() === data.val() + 2 && newData.parent().child('syringeDay').val() === now - now % 86400000 && data.parent().child('syringeDay').val() !== now - now % 86400000)))"
        },
        "lastStabTarget": { ".validate": "newData.isString() && newData.val().length < 40" },
        "stabs": {
          "$target": {
            ".validate": "newData.isNumber() && newData.val() === now - now % 86400000 && (!data.exists() || data.val() < newData.val()) && $target !== $uid && root.child('profiles').child($target).exists()"
          }
        },
        "syringeDay": {
          ".validate": "newData.isNumber() && newData.val() === now - now % 86400000 && (!data.exists() || data.val() < newData.val())"
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "seenDoor": { ".validate": "newData.isBoolean()" },

        "inventory": {
          "$slot": {
            ".validate": "$slot.matches(/^([0-9]|1[0-9]|2[0-7])$/) && newData.hasChildren(['item', 'qty'])",
            "item": { ".validate": "newData.val() === 'knife' || newData.val() === 'cd' || newData.val() === 'syringe'" },
            "qty": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000" },
            "inPlayer": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "owned": {
          "$item": { ".validate": "newData.val() === true" }
        },
        "wardrobe": {
          "$slot": {
            ".validate": "newData.hasChildren(['figure', 'gender'])",
            "figure": { ".validate": "newData.isString() && newData.val().length < 200" },
            "gender": { ".validate": "newData.val() === 'M' || newData.val() === 'F'" }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "logs": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid', 'name', 'type', 'detail', 'ts']) && newData.child('type').isString() && newData.child('type').val().matches(/^[a-z_]{2,20}$/) && newData.child('detail').isString() && newData.child('detail').val().length <= 160 && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('ts').val() === now"
      }
    },

    "config": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
      "shop": {
        "$section": {
          "$key": {
            ".validate": "newData.hasChildren(['on', 'price']) && newData.child('on').isBoolean() && newData.child('price').isNumber() && newData.child('price').val() >= 0 && newData.child('price').val() <= 999"
          }
        }
      }
    },

    "usernames": {
      "$name": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && !data.exists() && newData.val() === auth.uid",
        ".validate": "newData.isString()"
      }
    },

    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'figure'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16" },
        "figure": { ".validate": "newData.isString() && newData.val().length < 200" },
        "$other": { ".validate": false }
      }
    },

    "presence": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      "$uid": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "room": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "idle": { ".validate": "newData.isBoolean()" },
        "since": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
        "$friend": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ((auth.uid === $uid && (!newData.exists() || root.child('friendRequests').child($uid).child($friend).exists() || root.child('friends').child($friend).child($uid).exists())) || (auth.uid === $friend && (!newData.exists() || root.child('friendRequests').child(auth.uid).child($uid).exists())))",
          ".validate": "newData.hasChildren(['since']) && newData.child('since').isNumber()"
        }
      }
    },

    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $to",
        "$from": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (($from === auth.uid && $from !== $to && !root.child('friends').child($to).child($from).exists()) || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['ts']) && newData.child('ts').isNumber()"
        }
      }
    },

    "dms": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
      "$uid": {
        "$other": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
          ".indexOn": ["ts"],
          "$msg": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && !data.exists() && newData.child('from').val() === auth.uid && (auth.uid === $uid || auth.uid === $other) && root.child('friends').child($uid).child($other).exists() && root.child('friends').child($other).child($uid).exists()",
            ".validate": "newData.hasChildren(['from', 'text', 'ts']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 200 && newData.child('ts').isNumber()"
          }
        }
      }
    },

    "invites": {
      "$to": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $to",
        "$id": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ((auth.uid === $to && !newData.exists()) || (!data.exists() && newData.child('from').val() === auth.uid && root.child('friends').child($to).child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['room', 'roomName', 'from', 'fromName', 'ts'])"
        }
      }
    },

    "roomInvites": {
      "$room": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('roomsMeta').child($room).child('owner').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid"
        }
      }
    },

    "knocks": {
      "$owner": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $owner",
        "$visitor": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $visitor",
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ((auth.uid === $visitor && $visitor !== $owner && (!newData.exists() || root.child('roomsMeta').child('u_' + $owner).child('access').val() !== 'closed')) || (auth.uid === $owner && !newData.exists()))",
          ".validate": "newData.hasChildren(['name', 'ts']) && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('ts').isNumber() && newData.child('ts').val() === now"
        }
      }
    },

    "furni": {
      "meta": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        "$kind": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
          ".validate": "$kind.matches(/^x_[a-z0-9_]{1,24}$/) && newData.hasChildren(['name', 'w', 'h', 'players', 'flat'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 28" },
          "w": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8" },
          "h": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8" },
          "players": { ".validate": "newData.isBoolean()" },
          "flat": { ".validate": "newData.isBoolean()" },
          "ox": { ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200" },
          "oy": { ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200" },
          "height": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300" },
          "dirs": { ".validate": "true" },
          "rev": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": "false" }
        }
      },
      "sheet": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        "$kind": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
          ".validate": "$kind.matches(/^x_[a-z0-9_]{1,24}$/) && newData.hasChildren(['png', 'json'])",
          "png": { ".validate": "newData.isString() && newData.val().length < 700000" },
          "json": { ".validate": "newData.isString() && newData.val().length < 60000" },
          "$other": { ".validate": "false" }
        }
      }
    },

    "lobby": {
      "furni": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
        "$f": {
          ".validate": "newData.hasChildren(['kind', 'x', 'y'])",
          "kind": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 12" },
          "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 12" },
          "dir": { ".validate": "newData.val() === 0 || newData.val() === 2 || newData.val() === 4 || newData.val() === 6" },
          "$other": { ".validate": "false" }
        }
      }
    },

    "designs": {
      "meta": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        "$id": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
          ".validate": "$id.matches(/^[0-9]{5,7}$/) && newData.hasChildren(['name', 'slot', 'gender', 'parts', 'published'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 28" },
          "slot": { ".validate": "newData.isString() && newData.val().length <= 3" },
          "gender": { ".validate": "newData.val() === 'M' || newData.val() === 'F' || newData.val() === 'U'" },
          "published": { ".validate": "newData.isBoolean()" },
          "rev": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "base": { ".validate": "newData.hasChildren(['type', 'id'])" },
          "parts": { ".validate": "newData.hasChildren()" },
          "hidden": { ".validate": "true" },
          "recipe": { ".validate": "true" },
          "$other": { ".validate": "false" }
        }
      },
      "sheet": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        "$id": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
          ".validate": "$id.matches(/^[0-9]{5,7}$/) && newData.hasChildren(['png', 'frames'])",
          "png": { ".validate": "newData.isString() && newData.val().length < 900000" },
          "frames": { ".validate": "true" },
          "$other": { ".validate": "false" }
        }
      }
    },

    "roomsMeta": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      "$room": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (root.child('roomsMeta').child($room).child('owner').val() === auth.uid || (!data.exists() && $room === 'u_' + auth.uid))",
        ".validate": "newData.hasChildren(['owner', 'ownerName', 'name', 'access', 'w', 'h'])",
        "owner": { ".validate": "newData.val() === $room.replace('u_', '')" },
        "ownerName": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "name": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 28" },
        "access": { ".validate": "newData.val() === 'open' || newData.val() === 'knock' || newData.val() === 'closed' || newData.val() === 'friends' || newData.val() === 'invite'" },
        "w": { ".validate": "newData.isNumber() && newData.val() >= 6 && newData.val() <= 16" },
        "h": { ".validate": "newData.isNumber() && newData.val() >= 6 && newData.val() <= 16" },
        "theme": {
          "floorA": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
          "floorB": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
          "wall": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
          "rug": { ".validate": "newData.isBoolean()" },
          "rugColor": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
          "floorTex": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,24}$/)" },
          "wallTex": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,24}$/)" },
          "$other": { ".validate": false }
        },
        "furni": {
          "$f": {
            ".validate": "newData.hasChildren(['kind', 'x', 'y'])",
            "kind": { ".validate": "newData.val() === 'crate' || newData.val() === 'table' || newData.val() === 'sofa' || newData.val() === 'plant' || newData.val() === 'lamp' || newData.val() === 'shelf' || root.child('furni').child('meta').child(newData.val()).child('players').val() === true" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 16" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 16" },
            "dir": { ".validate": "newData.val() === 0 || newData.val() === 2 || newData.val() === 4 || newData.val() === 6" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "rooms": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email === 'admin@users.bobba.invalid'",
      "$room": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ($room === 'lobby' || root.child('roomsMeta').child($room).child('owner').val() === auth.uid || root.child('roomsMeta').child($room).child('access').val() === 'open' || root.child('roomInvites').child($room).child(auth.uid).exists() || root.child('friends').child(root.child('roomsMeta').child($room).child('owner').val()).child(auth.uid).exists())",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid && ($room === 'lobby' || root.child('roomsMeta').child($room).child('owner').val() === auth.uid || root.child('roomsMeta').child($room).child('access').val() === 'open' || root.child('roomInvites').child($room).child(auth.uid).exists() || root.child('friends').child(root.child('roomsMeta').child($room).child('owner').val()).child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['name', 'figure', 'x', 'y', 'dir'])",
            "emote": {
              "id": { ".validate": "newData.isString() && (newData.val() === 'wave' || newData.val() === 'smile' || newData.val() === 'sad' || newData.val() === 'jump' || root.child('users').child(auth.uid).child('owned').child('emote_' + newData.val()).exists() || root.child('config').child('shop').child('emotes').child(newData.val()).child('price').val() === 0)" },
              "ts": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },
        "chat": {
          ".indexOn": ["ts"],
          "$msg": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ($room === 'lobby' || root.child('roomsMeta').child($room).child('owner').val() === auth.uid || root.child('roomsMeta').child($room).child('access').val() === 'open' || root.child('roomInvites').child($room).child(auth.uid).exists() || root.child('friends').child(root.child('roomsMeta').child($room).child('owner').val()).child(auth.uid).exists()) && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('ts').val() < now - 900000))",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'ts']) && newData.child('text').isString() && newData.child('text').val().length <= 100 && newData.child('text').val().length > 0"
          }
        },
        "cdplayer": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && $room === 'lobby' && ((newData.exists() && newData.child('by').val() === auth.uid && (!data.exists() || now >= data.child('endsAt').val())) || (!newData.exists() && data.exists() && (data.child('by').val() === auth.uid || now >= data.child('endsAt').val())))",
          ".validate": "newData.hasChildren(['by', 'byName', 'track', 'title', 'startedAt', 'endsAt']) && newData.child('startedAt').val() === now && newData.child('endsAt').isNumber() && newData.child('endsAt').val() > now && newData.child('endsAt').val() <= now + 1800000 && newData.child('track').val() === 'standin' && newData.child('title').isString() && newData.child('title').val().length <= 40 && newData.child('byName').isString() && newData.child('byName').val().length <= 16"
        },
        "events": {
          ".indexOn": ["ts"],
          "$event": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && !data.exists() && newData.child('from').val() === auth.uid && ($room === 'lobby' || root.child('roomsMeta').child($room).child('owner').val() === auth.uid || root.child('roomsMeta').child($room).child('access').val() === 'open' || root.child('roomInvites').child($room).child(auth.uid).exists() || root.child('friends').child(root.child('roomsMeta').child($room).child('owner').val()).child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['type', 'from', 'to', 'ts']) && ((newData.child('type').val() === 'stab' && newData.child('to').val() !== auth.uid && (root.child('rooms').child($room).child('players').child(newData.child('to').val()).exists() || root.child('roomsMeta').child($room).child('owner').val() === newData.child('to').val())) || (newData.child('type').val() === 'syringe' && newData.child('to').val() === auth.uid))"
          }
        }
      }
    }
  }
}
