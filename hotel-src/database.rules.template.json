{
  "rules": {
    "users": {
      ".read": "@ADMIN@",
      "$uid": {
        ".read": "@PW@ && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16 && newData.val().matches(/^[A-Za-z0-9_.-]+$/)"
        },
        "gender": {
          ".validate": "newData.val() === 'M' || newData.val() === 'F'"
        },
        "figure": {
          ".validate": "newData.isString() && newData.val().length < 200"
        },
        "blood": {
          ".validate": "newData.isNumber() && newData.val() === 0"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "seenDoor": {
          ".write": "@PW@ && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        },
        "wardrobe": {
          ".write": "@PW@ && auth.uid === $uid",
          "$slot": {
            ".validate": "$slot.matches(/^[0-7]$/) && newData.hasChildren(['figure', 'gender'])",
            "figure": {
              ".validate": "newData.isString() && newData.val().length < 200"
            },
            "gender": {
              ".validate": "newData.val() === 'M' || newData.val() === 'F'"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "bloodBoard": {
      ".read": "@PW@"
    },
    "flappyBoard": {
      ".read": "@PW@"
    },
    "ideas": {
      ".read": "@PW@"
    },
    "raffle": {
      "round": {
        ".read": "@PW@"
      },
      "tickets": {
        ".read": "@PW@"
      },
      "last": {
        ".read": "@PW@"
      },
      "prizes": {
        "$uid": {
          ".read": "@PW@ && auth.uid === $uid"
        }
      }
    },
    "bagmand": {
      ".read": "@PW@"
    },
    "broadcast": {
      ".read": "@PW@"
    },
    "hideouts": {
      "$uid": {
        ".read": "@PW@ && auth.uid === $uid"
      }
    },
    "hideoutInvites": {
      "$uid": {
        ".read": "@PW@ && auth.uid === $uid"
      }
    },
    "hideoutKnocks": {
      "$owner": {
        ".read": "@PW@ && auth.uid === $owner",
        "$visitor": {
          ".read": "@PW@ && auth.uid === $visitor",
          ".write": "@PW@ && ((auth.uid === $visitor && $visitor !== $owner && (!newData.exists() || (root.child('roomsMeta').child('h_' + $owner).child('owner').exists() && root.child('roomsMeta').child('h_' + $owner).child('listed').val() !== false))) || (auth.uid === $owner && !newData.exists()))",
          ".validate": "newData.hasChildren(['name', 'ts']) && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('ts').isNumber() && newData.child('ts').val() === now"
        }
      }
    },
    "hideoutFavs": {
      "$uid": { ".read": "@PW@ && auth.uid === $uid" }
    },
    "rocketAt": {
      "$uid": { ".read": "@PW@ && auth.uid === $uid" }
    },
    "hitRevenge": {
      "$uid": { ".read": "@PW@ && auth.uid === $uid" }
    },
    "hitCool": {
      "$owner": {
        ".read": "@PW@ && (auth.uid === $owner || root.child('roomsMeta').child('h_' + $owner).child('members').child(auth.uid).exists())"
      }
    },
    "hits": {
      ".read": "@PW@"
    },
    "poker": {
      "$table": { ".read": "@PW@" }
    },
    "pokerHole": {
      "$table": {
        "$uid": { ".read": "@PW@ && auth.uid === $uid" }
      }
    },
    "blackjack": {
      "$table": { ".read": "@PW@" }
    },
    "bjHole": {
      "$table": { ".read": "@PW@ && auth.uid === root.child('blackjack').child($table).child('dealer').child('uid').val()" }
    },
    "bjSeat": {
      "$uid": { ".read": "@PW@ && auth.uid === $uid" }
    },
    "pokerSeat": {
      "$uid": { ".read": "@PW@ && auth.uid === $uid" }
    },
    "hideoutChests": {
      "$owner": {
        ".read": "@PW@ && (auth.uid === $owner || root.child('roomsMeta').child('h_' + $owner).child('members').child(auth.uid).exists())"
      }
    },
    "hideoutList": {
      ".read": "@PW@"
    },
    "loudspeaker": {
      "$uid": {
        ".read": "@PW@ && auth.uid === $uid"
      }
    },
    "sendHome": {
      "$uid": {
        ".read": "@PW@ && auth.uid === $uid"
      }
    },
    "ideasImg": {
      "$id": {
        ".read": "@PW@"
      }
    },
    "bans": {
      ".read": "@MOD@"
    },
    "roles": {
      ".read": "@MOD@",
      "$uid": {
        ".read": "@PW@ && auth.uid === $uid"
      }
    },
    "mutes": {
      ".read": "@MOD@",
      "$uid": {
        ".read": "@PW@ && auth.uid === $uid"
      }
    },
    "perks": {
      ".read": "@MOD@",
      "$uid": {
        ".read": "@PW@ && auth.uid === $uid"
      }
    },
    "reports": {
      ".read": "@MOD@"
    },
    "modLog": {
      ".read": "@MOD@"
    },
    "notices": {
      ".read": "@MOD@",
      "_all": {
        ".read": "@PW@"
      },
      "$uid": {
        ".read": "@PW@ && auth.uid === $uid"
      }
    },
    "kicks": {
      ".read": "@MOD@",
      "$uid": {
        ".read": "@PW@ && auth.uid === $uid"
      }
    },
    "backupIndex": {
      ".read": "@ADMIN@"
    },
    "backupBlood": {
      ".read": "@ADMIN@"
    },
    "backupData": {
      ".read": false
    },
    "rollbackLog": {
      ".read": "@ADMIN@"
    },
    "ledger": {
      ".read": "@ADMIN@"
    },
    "posterMutes": {
      ".read": "@ADMIN@"
    },
    "logs": {
      ".read": "@ADMIN@",
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".write": "@PW@ && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid', 'name', 'type', 'detail', 'ts']) && newData.child('type').isString() && newData.child('type').val().matches(/^[a-z_]{2,20}$/) && newData.child('detail').isString() && newData.child('detail').val().length <= 160 && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('ts').val() === now"
      }
    },
    "chatLog": {
      ".read": "@MOD@",
      ".indexOn": [
        "ts",
        "room",
        "uid"
      ],
      "$id": {
        ".write": "@PW@ && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && @KNOWN@ && @UNMUTED@ && ((newData.child('room').val() !== 'lobby' && newData.child('room').val() !== 'shop') || @AGED@)",
        ".validate": "newData.hasChildren(['uid', 'name', 'text', 'room', 'ts']) && newData.child('text').isString() && newData.child('text').val().length <= 100 && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('room').isString() && newData.child('room').val().length <= 40 && newData.child('ts').val() === now"
      }
    },
    "config": {
      ".read": "@PW@",
      ".write": "@ADMIN@",
      "shop": {
        "$section": {
          "$key": {
            ".validate": "newData.hasChildren(['on', 'price']) && newData.child('on').isBoolean() && newData.child('price').isNumber() && newData.child('price').val() >= 0 && newData.child('price').val() <= 999 && (!newData.child('starter').exists() || newData.child('starter').val() === true)"
          }
        }
      },
      "furniShop": {
        "today": {
          ".validate": "newData.hasChildren(['day', 'picks']) && newData.child('day').isNumber() && newData.child('picks').hasChildren()",
          "picks": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            }
          }
        },
        "prices": {
          "$kind": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
          }
        }
      },
      "npc": {
        "$id": {
          ".validate": "newData.hasChildren(['figure', 'gender']) && newData.child('figure').isString() && newData.child('figure').val().length < 200 && (newData.child('gender').val() === 'M' || newData.child('gender').val() === 'F')"
        }
      },
      "priceBook": {
        "clothing": {
          "$key": {
            ".validate": "newData.child('p').isNumber() && newData.child('p').val() >= 1 && newData.child('p').val() <= 999 && (newData.child('on').val() === 0 || newData.child('on').val() === 1)"
          }
        }
      }
    },
    "usernames": {
      "$name": {
        ".read": "@PW@",
        ".write": "@PW@ && !data.exists() && newData.val() === auth.uid && !$name.matches(/^(blodigoktober|lemonadekober)/)",
        ".validate": "newData.isString()"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "@PW@",
        ".write": "@PW@ && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'figure'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
        },
        "figure": {
          ".validate": "newData.isString() && newData.val().length < 200 && (newData.val() === root.child('users').child($uid).child('figure').val() || @ADMIN@)"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "bg": {
          ".validate": "newData.isString() && newData.val().matches(/^(pink|blue|green|purple|gold|dark)$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "relations": {
      ".read": "@PW@",
      "$uid": {
        "$other": {
          ".write": "@PW@ && ((auth.uid === $uid && (!newData.exists() || root.child('relationRequests').child($uid).child($other).exists() || root.child('relations').child($other).child($uid).exists())) || (auth.uid === $other && (!newData.exists() || root.child('relationRequests').child(auth.uid).child($uid).exists())))",
          ".validate": "newData.hasChildren(['kind', 'since']) && (newData.child('kind').val() === 'partner' || newData.child('kind').val() === 'bff') && newData.child('since').isNumber() && root.child('friends').child($uid).child($other).exists()"
        }
      }
    },
    "relationRequests": {
      "$to": {
        ".read": "@PW@ && auth.uid === $to",
        "$from": {
          ".read": "@PW@ && auth.uid === $from",
          ".write": "@PW@ && ((auth.uid === $from && (!newData.exists() || root.child('friends').child($from).child($to).exists())) || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['kind', 'ts']) && (newData.child('kind').val() === 'partner' || newData.child('kind').val() === 'bff') && newData.child('ts').isNumber() && newData.child('ts').val() === now"
        }
      }
    },
    "gifts": {
      "$to": {
        ".read": "@PW@ && auth.uid === $to"
      }
    },
    "giftReturns": {
      "$from": {
        ".read": "@PW@ && auth.uid === $from"
      }
    },
    "presence": {
      ".read": "@PW@",
      "$uid": {
        ".write": "@PW@ && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "room": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "idle": {
          ".validate": "newData.isBoolean()"
        },
        "since": {
          ".validate": "newData.isNumber()"
        },
        "seen": {
          ".validate": "newData.isNumber()"
        },
        "sid": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "@PW@ && auth.uid === $uid",
        "$friend": {
          ".write": "@PW@ && ((auth.uid === $uid && (!newData.exists() || root.child('friendRequests').child($uid).child($friend).exists() || root.child('friends').child($friend).child($uid).exists())) || (auth.uid === $friend && (!newData.exists() || root.child('friendRequests').child(auth.uid).child($uid).exists())))",
          ".validate": "newData.hasChildren(['since']) && newData.child('since').isNumber()"
        }
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "@PW@ && auth.uid === $to",
        "$from": {
          ".write": "@PW@ && (($from === auth.uid && $from !== $to && !root.child('friends').child($to).child($from).exists()) || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['ts']) && newData.child('ts').isNumber()"
        }
      }
    },
    "dmLog": {
      ".read": "@MOD@",
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".write": "@PW@ && @KNOWN@ && @UNMUTED@ && !data.exists() && newData.exists() && newData.child('from').val() === auth.uid",
        ".validate": "newData.hasChildren(['from', 'to', 'text', 'ts']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 200 && newData.child('ts').val() === now && (!newData.child('fromName').exists() || (newData.child('fromName').isString() && newData.child('fromName').val().length <= 40))"
      }
    },
    "dms": {
      ".read": "@MOD@",
      "$uid": {
        "$other": {
          ".read": "@PW@ && auth.uid === $uid",
          ".indexOn": [
            "ts"
          ],
          "$msg": {
            ".write": "@PW@ && @UNMUTED@ && !data.exists() && newData.child('from').val() === auth.uid && (auth.uid === $uid || auth.uid === $other) && root.child('friends').child($uid).child($other).exists() && root.child('friends').child($other).child($uid).exists()",
            ".validate": "newData.hasChildren(['from', 'text', 'ts']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 200 && newData.child('ts').isNumber()"
          }
        }
      }
    },
    "invites": {
      "$to": {
        ".read": "@PW@ && auth.uid === $to",
        "$id": {
          ".write": "@PW@ && ((auth.uid === $to && !newData.exists()) || (!data.exists() && newData.child('from').val() === auth.uid && root.child('friends').child($to).child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['room', 'roomName', 'from', 'fromName', 'ts'])"
        }
      }
    },
    "roomInvites": {
      "$room": {
        ".write": "@PW@ && root.child('roomsMeta').child($room).child('owner').val() === auth.uid",
        "$uid": {
          ".read": "@PW@ && auth.uid === $uid",
          ".write": "@PW@ && auth.uid === $uid && !newData.exists()",
          ".validate": "newData.val() === true"
        }
      }
    },
    "knocks": {
      "$owner": {
        ".read": "@PW@ && auth.uid === $owner",
        "$visitor": {
          ".read": "@PW@ && auth.uid === $visitor",
          ".write": "@PW@ && ((auth.uid === $visitor && $visitor !== $owner && (!newData.exists() || root.child('roomsMeta').child('u_' + $owner).child('access').val() !== 'closed' && root.child('roomsMeta').child('u_' + $owner).child('access').val() !== 'none')) || (auth.uid === $owner && !newData.exists()))",
          ".validate": "newData.hasChildren(['name', 'ts']) && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('ts').isNumber() && newData.child('ts').val() === now"
        }
      }
    },
    "tradeInvites": {
      "$to": {
        ".read": "@PW@ && auth.uid === $to",
        "$from": {
          ".write": "@PW@ && ((auth.uid === $from && $from !== $to) || auth.uid === $to)",
          ".validate": "newData.hasChildren(['name', 'ts']) && newData.child('name').isString() && newData.child('name').val().length <= 16 && newData.child('ts').isNumber()"
        }
      }
    },
    "userTrades": {
      "$uid": {
        ".read": "@PW@ && auth.uid === $uid",
        "$id": {
          ".write": "@PW@ && (auth.uid === $uid || newData.parent().parent().parent().child('trades').child($id).child('b').val() === auth.uid || newData.parent().parent().parent().child('trades').child($id).child('a').val() === auth.uid)",
          ".validate": "newData.val() === true"
        }
      }
    },
    "trades": {
      "$id": {
        ".read": "@PW@ && (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid)",
        ".write": "@PW@ && !data.exists() && newData.child('b').val() === auth.uid && newData.child('a').val() !== auth.uid",
        ".validate": "newData.hasChildren(['a', 'b', 'status'])",
        "a": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "b": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "names": {
          "$u": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          }
        },
        "status": {
          ".write": "@PW@ && (data.parent().child('a').val() === auth.uid || data.parent().child('b').val() === auth.uid) && data.val() !== 'done' && newData.val() !== 'done'",
          ".validate": "newData.val() === 'open' || newData.val() === 'cancelled'"
        },
        "offer": {
          "$u": {
            ".write": "@PW@ && auth.uid === $u && (data.parent().parent().child('a').val() === auth.uid || data.parent().parent().child('b').val() === auth.uid) && data.parent().parent().child('status').val() !== 'done' && !newData.parent().parent().child('ready').exists() && !newData.parent().parent().child('confirm').exists()",
            ".validate": "newData.hasChildren(['blood']) && newData.child('blood').isNumber() && newData.child('blood').val() >= 0 && newData.child('blood').val() <= 99999",
            "blood": {
              ".validate": "true"
            },
            "items": {
              "$slot": {
                ".validate": "$slot.matches(/^([0-9]|1[0-9]|2[0-7])$/) && newData.hasChildren(['item', 'qty']) && newData.child('item').isString() && newData.child('item').val().length <= 40 && newData.child('qty').isNumber() && newData.child('qty').val() >= 1 && newData.child('qty').val() <= 999",
                "item": {
                  ".validate": "true"
                },
                "qty": {
                  ".validate": "true"
                },
                "ass": {
                  ".validate": "newData.isBoolean()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "ready": {
          "$u": {
            ".write": "@PW@ && (data.parent().parent().child('a').val() === auth.uid || data.parent().parent().child('b').val() === auth.uid) && data.parent().parent().child('status').val() !== 'done' && (auth.uid === $u || !newData.exists())",
            ".validate": "newData.val() === true"
          }
        },
        "confirm": {
          "$u": {
            ".write": "@PW@ && (data.parent().parent().child('a').val() === auth.uid || data.parent().parent().child('b').val() === auth.uid) && data.parent().parent().child('status').val() !== 'done' && (auth.uid === $u || !newData.exists())",
            ".validate": "newData.val() === true"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "furni": {
      "meta": {
        ".read": "@PW@",
        "$kind": {
          ".write": "@ADMIN@",
          ".validate": "$kind.matches(/^x_[a-z0-9_]{1,24}$/) && newData.hasChildren(['name', 'w', 'h', 'players', 'flat'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 28"
          },
          "w": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8"
          },
          "h": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8"
          },
          "players": {
            ".validate": "newData.isBoolean()"
          },
          "flat": {
            ".validate": "newData.isBoolean()"
          },
          "ox": {
            ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200"
          },
          "oy": {
            ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200"
          },
          "height": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
          },
          "dirs": {
            ".validate": "true"
          },
          "rev": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": "false"
          }
        }
      },
      "sheet": {
        ".read": "@PW@",
        "$kind": {
          ".write": "@ADMIN@",
          ".validate": "$kind.matches(/^x_[a-z0-9_]{1,24}$/) && newData.hasChildren(['png', 'json'])",
          "png": {
            ".validate": "newData.isString() && newData.val().length < 700000"
          },
          "json": {
            ".validate": "newData.isString() && newData.val().length < 60000"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "lobby": {
      "furni": {
        ".read": "@PW@",
        ".write": "@ADMIN@",
        "$f": {
          ".validate": "newData.hasChildren(['kind', 'x', 'y'])",
          "kind": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 12"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 26"
          },
          "dir": {
            ".validate": "newData.val() === 0 || newData.val() === 2 || newData.val() === 4 || newData.val() === 6"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "designs": {
      "meta": {
        ".read": "@PW@",
        "$id": {
          ".write": "@ADMIN@",
          ".validate": "$id.matches(/^[0-9]{5,7}$/) && newData.hasChildren(['name', 'slot', 'gender', 'parts', 'published'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 28"
          },
          "slot": {
            ".validate": "newData.isString() && newData.val().length <= 3"
          },
          "gender": {
            ".validate": "newData.val() === 'M' || newData.val() === 'F' || newData.val() === 'U'"
          },
          "published": {
            ".validate": "newData.isBoolean()"
          },
          "rev": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "base": {
            ".validate": "newData.hasChildren(['type', 'id'])"
          },
          "parts": {
            ".validate": "newData.hasChildren()"
          },
          "hidden": {
            ".validate": "true"
          },
          "recipe": {
            ".validate": "true"
          },
          "$other": {
