            ".validate": "false"
          }
        }
      }
    },
    "roomsMeta": {
      ".read": "@PW@",
      "$room": {
        ".write": "@PW@ && !data.exists() && $room === 'u_' + auth.uid && !newData.child('furni').exists() && !newData.child('skins').exists()",
        ".validate": "newData.hasChildren(['owner', 'ownerName', 'name', 'access', 'w', 'h'])",
        "owner": {
          ".validate": "newData.val() === $room.replace('u_', '')"
        },
        "ownerName": {
          ".write": "@PW@ && data.parent().child('owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "name": {
          ".write": "@PW@ && data.parent().child('owner').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 28"
        },
        "access": {
          ".write": "@PW@ && data.parent().child('owner').val() === auth.uid",
          ".validate": "newData.val() === 'open' || newData.val() === 'knock' || newData.val() === 'closed' || newData.val() === 'none' || newData.val() === 'friends' || newData.val() === 'invite'"
        },
        "w": {
          ".validate": "newData.isNumber() && newData.val() >= 6 && newData.val() <= 24"
        },
        "h": {
          ".validate": "newData.isNumber() && newData.val() >= 6 && newData.val() <= 24"
        },
        "skins": {
          "bed": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,16}$/)"
          },
          "bag": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,16}$/)"
          },
          "$other": {
            ".validate": false
          }
        },
        "theme": {
          "floorA": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "floorB": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "wall": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "rug": {
            ".validate": "newData.isBoolean()"
          },
          "rugColor": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "floorTex": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,24}$/)"
          },
          "wallTex": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,24}$/)"
          },
          "$other": {
            ".validate": false
          }
        },
        "bed": {
          ".write": "@PW@ && data.parent().child('owner').val() === auth.uid",
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "dir": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
          },
          "$other": {
            ".validate": false
          }
        },
        "bag": {
          ".write": "@PW@ && data.parent().child('owner').val() === auth.uid",
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "dir": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
          },
          "$other": {
            ".validate": false
          }
        },
        "toolbox": {
          ".write": "@PW@ && data.parent().child('owner').val() === auth.uid",
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "dir": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
          },
          "$other": {
            ".validate": false
          }
        },
        "computer": {
          ".write": "@PW@ && data.parent().child('owner').val() === auth.uid",
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "dir": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
          },
          "$other": {
            ".validate": false
          }
        },
        "chest": {
          ".write": "@PW@ && data.parent().child('owner').val() === auth.uid",
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "dir": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
          },
          "$other": {
            ".validate": false
          }
        },
        "stashbox": {
          ".write": "@PW@ && data.parent().child('owner').val() === auth.uid",
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "dir": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
          },
          "$other": {
            ".validate": false
          }
        },
        "boombox": {
          ".write": "@PW@ && data.parent().child('owner').val() === auth.uid",
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "dir": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
          },
          "$other": {
            ".validate": false
          }
        },
        "sink": {
          ".write": "@PW@ && data.parent().child('owner').val() === auth.uid",
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "dir": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
          },
          "$other": {
            ".validate": false
          }
        },
        "furni": {
          "$f": {
            ".validate": "newData.hasChildren(['kind', 'x', 'y'])",
            "kind": {
              ".validate": "newData.val() === 'crate' || newData.val() === 'table' || newData.val() === 'sofa' || newData.val() === 'plant' || newData.val() === 'lamp' || newData.val() === 'shelf' || newData.val().matches(/^f_[a-z0-9_]{1,30}$/) || root.child('furni').child('meta').child(newData.val()).child('players').val() === true"
            },
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
            },
            "dir": {
              ".validate": "newData.val() === 0 || newData.val() === 2 || newData.val() === 4 || newData.val() === 6"
            },
            "plantedAt": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "wateredAt": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "neglect": {
              ".validate": "newData.isBoolean()"
            },
            "crop": {
              ".validate": "newData.isString() && (newData.val() === 'shroom' || newData.val() === 'poppy')"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().length < 60"
            },
            "img": {
              ".validate": "newData.isString() && newData.val().length < 12000 && newData.val().beginsWith('data:image/png;base64,')"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        },
        "intercom": {
          ".write": "@PW@ && data.parent().child('owner').val() === auth.uid",
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24"
          },
          "dir": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "rooms": {
      ".read": "@ADMIN@",
      "$room": {
        ".read": "@PW@ && @IN@",
        "players": {
          "$uid": {
            ".write": "@PW@ && auth.uid === $uid && @KNOWN@ && @IN@",
            ".validate": "newData.hasChildren(['name', 'figure', 'x', 'y', 'dir'])",
            "smoke": {
              ".validate": "newData.isNumber()"
            },
            "smokeKind": {
              ".validate": "newData.isString() && (newData.val() === 'cigarette' || newData.val() === 'joint' || newData.val() === 'blunt' || newData.val() === 'hashjoint' || newData.val() === 'chudjoint' || newData.val() === 'chudblunt')"
            },
            "sit": {
              ".validate": "newData.isBoolean()"
            },
            "lay": {
              ".validate": "newData.isBoolean()"
            },
            "sixty": {
              ".validate": "newData.val() === true && @ADMIN@"
            },
            "emote": {
              "id": {
                ".validate": "newData.isString() && (newData.val() === 'wave' || newData.val() === 'smile' || newData.val() === 'sad' || newData.val() === 'jump' || newData.val() === 'angry' || newData.val() === 'surprised' || newData.val() === 'sleep' || newData.val() === 'laugh' || newData.val() === 'love' || newData.val() === 'cheer' || newData.val() === 'spin' || newData.val() === 'dance')"
              },
              "ts": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            },
            "fast": {
              ".validate": "newData.isNumber()"
            },
            "bed": {
              ".validate": "newData.isBoolean()"
            },
            "fastMult": {
              ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 10"
            },
            "cup": {
              ".validate": "newData.isNumber()"
            },
            "chem": {
              ".validate": "newData.isNumber()"
            },
            "chud": {
              ".validate": "newData.isNumber()"
            },
            "spin": {
              ".validate": "newData.isNumber()"
            },
            "look": {
              ".validate": "newData.isString() && newData.val() === root.child('users').child($uid).child('lookKind').val()"
            },
            "lookUntil": {
              ".validate": "newData.isNumber()"
            },
            "un": {
              ".validate": "newData.isString() && newData.val() === root.child('users').child($uid).child('unusual').val()"
            },
            "pet": {
              ".validate": "newData.isString() && newData.val() === root.child('users').child($uid).child('petLook').val()"
            },
            "nc": {
              ".validate": "newData.isString() && newData.val() === root.child('users').child($uid).child('nameColor').val()"
            }
          }
        },
        "chat": {
          ".indexOn": [
            "ts"
          ],
          "$msg": {
            ".write": "@PW@ && @IN@ && ((!data.exists() && newData.child('uid').val() === auth.uid && @KNOWN@ && @UNMUTED@ && (($room !== 'lobby' && $room !== 'shop') || @AGED@)) || (data.exists() && !newData.exists() && data.child('ts').val() < now - 900000))",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'ts']) && newData.child('text').isString() && newData.child('text').val().length <= 100 && newData.child('text').val().length > 0",
            "fx": {
              ".validate": "newData.isString() && (newData.val() === 'shake' || newData.val() === 'wave' || newData.val() === 'rainbow' || newData.val() === 'pulse' || newData.val() === 'big') && root.child('users').child(auth.uid).child('owned').child('ducky_fx').exists()"
            },
            "fc": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/) && root.child('users').child(auth.uid).child('owned').child('ducky_fx').exists()"
            }
          }
        },
        "drops": {
          "$tile": {
            ".write": "@PW@ && @IN@ && data.exists() && !newData.exists() && data.child('exp').exists() && data.child('exp').val() <= now",
            ".validate": "false"
          }
        },
        "cdplayer": {
          ".write": "@PW@ && data.exists() && !newData.exists() && data.child('endsAt').val() < now && !data.child('pausedAt').exists()"
        },
        "events": {
          ".indexOn": [
            "ts"
          ],
          "$event": {
            ".write": "@PW@ && !data.exists() && newData.child('from').val() === auth.uid && @IN@",
            ".validate": "newData.hasChildren(['type', 'from', 'to', 'ts']) && ((newData.child('type').val() === 'stab' && newData.child('to').val() !== auth.uid && (root.child('rooms').child($room).child('players').child(newData.child('to').val()).exists() || root.child('roomsMeta').child($room).child('owner').val() === newData.child('to').val())) || (newData.child('type').val() === 'syringe' && newData.child('to').val() === auth.uid))"
          }
        }
      }
    }
  }
